{
  "expo": {
    "name": "Mi Cuaderno Digital",
    "slug": "tienda-offline",
    "version": "1.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EA580C"
      },
      "package": "com.tienda.offline",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permiso para escanear facturas y códigos de barras."
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "cea9794e-b484-472f-9154-b8cbbdcef8ad"
      }
    }
  }
}
