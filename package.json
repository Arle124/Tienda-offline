{
  "name": "tienda-offline",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión Offline-First para tienda de barrio",
  "scripts": {
    "mobile": "pnpm --filter mobile start",
    "mobile:web": "pnpm --filter mobile web",
    "mobile:tunnel": "pnpm --filter mobile tunnel",
    "backend": "pnpm --filter backend dev",
    "build:shared": "pnpm --filter @tienda/shared build",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
